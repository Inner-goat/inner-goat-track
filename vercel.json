{
  "trailingSlash": false,
  "crons": [
    { "path": "/api/sync-to-flow", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/r/:id", "destination": "/api/r/:id" },
    { "source": "/r/:id/", "destination": "/api/r/:id" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/ideen", "destination": "/ideen.html" },
    { "source": "/ideen/", "destination": "/ideen.html" },
    { "source": "/ki", "destination": "/ki.html" },
    { "source": "/ki/", "destination": "/ki.html" },
    { "source": "/skills", "destination": "/skills.html" },
    { "source": "/skills/", "destination": "/skills.html" },
    { "source": "/empfehlung", "destination": "/empfehlung.html" },
    { "source": "/empfehlung/", "destination": "/empfehlung.html" },
    { "source": "/ritter", "destination": "/api/r/ritter" },
    { "source": "/ritter/", "destination": "/api/r/ritter" }
  ]
}
